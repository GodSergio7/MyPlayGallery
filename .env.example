# MyPlayGallery — variables de entorno (documentación)
#
# Copia este archivo como .env.local y rellena los valores reales.
# .env.local está ignorado por git. No introduzcas secretos en variables VITE_*:
# todas se incluyen en el bundle del cliente.

# URL del proyecto de Supabase (pública)
VITE_SUPABASE_URL=

# Clave anónima de Supabase (pública por diseño si RLS está configurado)
VITE_SUPABASE_ANON_KEY=

# --- Secretos de servidor (NO usar el prefijo VITE_ y NO incluir en el cliente) ---
#
# TWITCH_CLIENT_ID y TWITCH_CLIENT_SECRET: credenciales de la aplicación de Twitch
#   usadas por la Edge Function igdb-proxy para obtener el access token (Twitch
#   OAuth Client Credentials) y consultar la API de IGDB. Nunca deben llegar al
#   navegador ni al repositorio. Se configuran como secretos de Supabase:
#     supabase secrets set TWITCH_CLIENT_ID=...
#     supabase secrets set TWITCH_CLIENT_SECRET=...
#
# STEAM_API_KEY: clave de la Steam Web API (https://steamcommunity.com/dev/apikey).
#   La usa la Edge Function steam-library para leer los juegos, las horas y los logros.
#   Solo hace falta para importar desde Steam; entrar o conectar con Steam no la necesita.
#     supabase secrets set STEAM_API_KEY=...
#
# ALLOWED_ORIGINS: orígenes permitidos por CORS en las Edge Functions (opcional).
#   Si no se define, se usan los orígenes locales de Vite (5173 / 4173):
#     supabase secrets set ALLOWED_ORIGINS=https://tu-dominio
